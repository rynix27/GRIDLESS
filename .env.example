# Copy this file to a file named exactly ".env" and fill in your values.
# (Never commit .env — it holds secrets. It is already in .gitignore.)

# ---- Layer 1: cloud AI (OPTIONAL — leave blank to skip the cloud entirely) ----
# Works with any OpenAI-compatible API. Free option: Groq (no credit card)
#   1. Get a key at https://console.groq.com/keys
#   2. Paste it as OPENAI_API_KEY and uncomment the two lines below it
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
# Seconds-level timeout so a slow cloud falls through to the next layer fast
# CLOUD_TIMEOUT_MS=15000

# ---- Layer 2: local model via Ollama (free, fully offline) ----
# Use 127.0.0.1, not "localhost" — on Windows "localhost" can resolve to IPv6 and fail.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# First request can be slow while the model loads into memory
# Default 300000 (5 min). Slow CPU? Try a smaller model: OLLAMA_MODEL=llama3.2:1b
# OLLAMA_TIMEOUT_MS=300000

# ---- Server ----
PORT=3000
CONNECTIVITY_CHECK_URL=https://www.google.com/generate_204

# ---- Mesh security ----
# Set the SAME secret on every device you want to trust each other. Mesh packets
# are then HMAC-signed (with timestamp + replay protection) and AI relay between
# devices is enabled. Without it the mesh is OPEN: discovery and SOS still work,
# but anyone on the WiFi can spoof them, and peer relay is switched off.
NETWORK_KEY=

# ---- Using GridLess from a phone/another device on your WiFi ----
# Requests from other devices are refused unless you set a token, then open
#   http://<this-computer-ip>:3000/#token=<the token>
# ACCESS_TOKEN=pick-a-long-random-string

# Demo only: let devices relay AI requests without NETWORK_KEY. Insecure.
# ALLOW_OPEN_RELAY=1
